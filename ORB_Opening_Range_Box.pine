//@version=6

//──────────────────────────────────────────────────────────────────────────────
// ORB Opening Range Box
// Author: Yulien
// Version: 1.1.0
// Description: Automatically draws the opening range and provides confirmed
// 5-minute breakout alerts above or below the range.
//──────────────────────────────────────────────────────────────────────────────

indicator(
     title = "ORB Opening Range Box v1.1.0 — by Yulien",
     shorttitle = "ORB Box v1.1.0",
     overlay = true,
     max_boxes_count = 1,
     max_labels_count = 200)

//──────────────────────────────────────────────────────────────────────────────
// Supported chart context
//
// The rectangle remains available on standard, time-based intraday charts.
// The alert engine evaluates every confirmed 5-minute candle, so it remains
// available only when the chart timeframe is 5 minutes or lower. On higher
// chart timeframes, the script keeps the rectangle and enters visual-only mode.
//──────────────────────────────────────────────────────────────────────────────

bool supportedChartContext = chart.is_standard and timeframe.isintraday and not timeframe.isticks
bool fiveMinuteSignalsAvailable = false

if supportedChartContext
    fiveMinuteSignalsAvailable := timeframe.in_seconds() <= timeframe.in_seconds("5")

if not chart.is_standard
    runtime.error("ORB requires a standard chart that uses actual market OHLC prices.")

if not timeframe.isintraday or timeframe.isticks
    runtime.error("ORB rectangle requires a time-based intraday chart.")

//──────────────────────────────────────────────────────────────────────────────
// Inputs — ORB Rectangle
//──────────────────────────────────────────────────────────────────────────────

string orbTimeframe = input.timeframe(
     defval = "15",
     title = "Opening range timeframe",
     options = ["15", "30"],
     group = "ORB Rectangle")

color fillColor = input.color(
     defval = color.new(color.rgb(54, 9, 164), 85),
     title = "Fill color",
     group = "ORB Rectangle")

color borderColor = input.color(
     defval = color.rgb(54, 9, 164),
     title = "Border color",
     group = "ORB Rectangle")

int borderWidth = input.int(
     defval = 1,
     title = "Border width",
     minval = 1,
     maxval = 5,
     group = "ORB Rectangle")

int rightSpaceBars = input.int(
     defval = 3,
     title = "Dynamic right border spacing (bars)",
     minval = 0,
     maxval = 100,
     group = "ORB Rectangle")

//──────────────────────────────────────────────────────────────────────────────
// Inputs — Alerts
//──────────────────────────────────────────────────────────────────────────────

bool enableUpperAlert = input.bool(
     defval = true,
     title = "Enable upper breakout alert",
     group = "5M Alerts")

bool enableLowerAlert = input.bool(
     defval = true,
     title = "Enable lower breakout alert",
     group = "5M Alerts")

bool showSignalMarkers = input.bool(
     defval = false,
     title = "Show test markers",
     tooltip = "Displays confirmed breakouts for the current day. Useful for validating signals during Bar Replay.",
     group = "5M Alerts")

//──────────────────────────────────────────────────────────────────────────────
// Operating mode status
//──────────────────────────────────────────────────────────────────────────────

bool chartAboveOpeningRange = timeframe.in_seconds() > timeframe.in_seconds(orbTimeframe)
int openingRangeDurationMs = int(timeframe.in_seconds(orbTimeframe) * 1000)
int fiveMinuteDurationMs = 5 * 60 * 1000

var table signalStatusTable = table.new(
     position = position.top_right,
     columns = 1,
     rows = 1,
     frame_color = color.orange,
     frame_width = 1)

//──────────────────────────────────────────────────────────────────────────────
// Opening range calculation
//
// This function runs inside the selected ORB timeframe.
//
// When a new ORB-timeframe candle begins, the previous candle is confirmed.
// Accept only a complete opening candle from the same exchange calendar date.
//
// hour() and minute() use the symbol exchange timezone by default.
//──────────────────────────────────────────────────────────────────────────────

f_calendarDay(int barTime) =>
    year(barTime) * 10000 + month(barTime) * 100 + dayofmonth(barTime)

f_openingRange() =>
    var float confirmedHigh = na
    var float confirmedLow = na
    var int openingTime = na

    int requestedDay = f_calendarDay(time)
    bool requestedNewDay = na(requestedDay[1]) or requestedDay != requestedDay[1]

    if requestedNewDay
        confirmedHigh := na
        confirmedLow := na
        openingTime := na

    bool previousBarIsOpening = (
         not na(time[1]) and
         f_calendarDay(time[1]) == requestedDay and
         hour(time[1]) == 9 and minute(time[1]) == 30 and
         time_close[1] - time[1] == openingRangeDurationMs and
         not na(high[1]) and not na(low[1]) and high[1] >= low[1])

    if previousBarIsOpening
        confirmedHigh := high[1]
        confirmedLow := low[1]
        openingTime := time[1]

    [time, confirmedHigh, confirmedLow, openingTime]

// HTF/same-TF: offset prices with lookahead_on. LTF: select the LAST snapshot,
// since the first intrabar can contain only the day's reset. The function carries
// the confirmed range forward; no complete intrabar event stream is needed here.
[requestedTime, rangeHigh, rangeLow, rangeOpeningTime] = request.security(
     symbol = syminfo.tickerid,
     timeframe = orbTimeframe,
     expression = f_openingRange(),
     gaps = barmerge.gaps_off,
     lookahead = chartAboveOpeningRange ? barmerge.lookahead_off : barmerge.lookahead_on)

int chartDay = f_calendarDay(time)
bool rangeIsAvailable = (
     not na(rangeHigh) and not na(rangeLow) and rangeHigh >= rangeLow and
     not na(rangeOpeningTime) and
     f_calendarDay(rangeOpeningTime) == chartDay and
     f_calendarDay(requestedTime) == chartDay and
     rangeOpeningTime + openingRangeDurationMs <= time_close)

//──────────────────────────────────────────────────────────────────────────────
// Rectangle creation and updates
//──────────────────────────────────────────────────────────────────────────────

var box orbBox = na
var array<label> signalLabels = array.new<label>()

bool chartNewDay = na(chartDay[1]) or chartDay != chartDay[1]

if chartNewDay
    if not na(orbBox)
        box.delete(orbBox)
        orbBox := na

    for signalLabel in signalLabels
        label.delete(signalLabel)
    array.clear(signalLabels)

// The source range is already confirmed; an open chart bar need not delay it.
// Realtime rollback can recreate this drawing from the same confirmed snapshot.
bool newConfirmedRange = rangeIsAvailable and na(orbBox)

// The right border is projected using the chart bar duration.
int chartBarDurationMs = time_close - time
int dynamicRightTime = time_close + rightSpaceBars * chartBarDurationMs

if newConfirmedRange
    orbBox := box.new(
         left = rangeOpeningTime,
         top = rangeHigh,
         right = dynamicRightTime,
         bottom = rangeLow,
         xloc = xloc.bar_time,
         border_color = borderColor,
         border_width = borderWidth,
         bgcolor = fillColor)

if not na(orbBox)
    box.set_right(orbBox, dynamicRightTime)

if not rangeIsAvailable and not na(orbBox)
    box.delete(orbBox)
    orbBox := na

if barstate.islast
    if fiveMinuteSignalsAvailable and rangeIsAvailable
        table.clear(signalStatusTable, 0, 0, 0, 0)
    else
        string rangeStatus = not na(orbBox) ? "ORB rectangle active" : "ORB unavailable: waiting for a complete 09:30 range"
        string modeStatus = fiveMinuteSignalsAvailable ? "5M signals wait for valid range and candle data." : "Visual-only mode: 5M alerts and markers are unavailable on " + timeframe.period + "."
        table.cell(
             table_id = signalStatusTable,
             column = 0,
             row = 0,
             text = rangeStatus + "\n" + modeStatus,
             text_color = color.black,
             text_size = size.small,
             bgcolor = color.new(color.orange, 10))

//──────────────────────────────────────────────────────────────────────────────
// Confirmed 5-minute candles
//
// closedFiveMinuteTime corresponds to time[1] from the 5-minute context.
// When it changes, a new 5-minute candle has been fully confirmed.
//──────────────────────────────────────────────────────────────────────────────

[closedFiveMinuteTime, closedFiveMinuteCloseTime, precedingFiveMinuteCloseTime, closedFiveMinuteClose, precedingFiveMinuteClose] = request.security(
     symbol = syminfo.tickerid,
     timeframe = "5",
     expression = [time[1], time_close[1], time_close[2], close[1], close[2]],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

bool newConfirmedFiveMinuteCandle = ta.change(closedFiveMinuteTime) != 0

// Do not compare across missing candles, sessions, or an incomplete 5M bar.
// The request publishes on a subsequent source bar; its close must still be
// recent relative to the observing chart bar, not a stale pre-gap crossing.
bool signalTimesAreValid = (
     not na(closedFiveMinuteClose) and not na(precedingFiveMinuteClose) and
     closedFiveMinuteCloseTime - closedFiveMinuteTime == fiveMinuteDurationMs and
     precedingFiveMinuteCloseTime == closedFiveMinuteTime and
     closedFiveMinuteTime >= rangeOpeningTime + openingRangeDurationMs and
     f_calendarDay(closedFiveMinuteTime) == chartDay and
     closedFiveMinuteCloseTime <= time_close and
     time - closedFiveMinuteCloseTime < fiveMinuteDurationMs)

// Upper breakout:
// the previous 5-minute close was at or below the upper border and the new close
// finishes above the upper border.
bool upperBreakout = (
     fiveMinuteSignalsAvailable and
     newConfirmedFiveMinuteCandle and
     rangeIsAvailable and
     signalTimesAreValid and
     closedFiveMinuteClose > rangeHigh and
     precedingFiveMinuteClose <= rangeHigh)

// Lower breakout:
// the previous 5-minute close was at or above the lower border and the new close
// finishes below the lower border.
bool lowerBreakout = (
     fiveMinuteSignalsAvailable and
     newConfirmedFiveMinuteCandle and
     rangeIsAvailable and
     signalTimesAreValid and
     closedFiveMinuteClose < rangeLow and
     precedingFiveMinuteClose >= rangeLow)

//──────────────────────────────────────────────────────────────────────────────
// Test markers — current day only
//
// Unlike plot outputs, labels can be deleted when a new chart day begins.
// Keeping their IDs in signalLabels ensures that prior-day markers disappear
// during an uninterrupted realtime session as well as after a script reload.
//──────────────────────────────────────────────────────────────────────────────

bool showUpperMarker = (
     showSignalMarkers and
     upperBreakout)

bool showLowerMarker = (
     showSignalMarkers and
     lowerBreakout)

if showUpperMarker
    label upperMarker = label.new(
         x = closedFiveMinuteTime,
         y = closedFiveMinuteClose,
         text = "ORB↑",
         xloc = xloc.bar_time,
         yloc = yloc.abovebar,
         color = color.lime,
         style = label.style_triangleup,
         textcolor = color.lime,
         size = size.small)
    array.push(signalLabels, upperMarker)

if showLowerMarker
    label lowerMarker = label.new(
         x = closedFiveMinuteTime,
         y = closedFiveMinuteClose,
         text = "ORB↓",
         xloc = xloc.bar_time,
         yloc = yloc.belowbar,
         color = color.red,
         style = label.style_triangledown,
         textcolor = color.red,
         size = size.small)
    array.push(signalLabels, lowerMarker)

//──────────────────────────────────────────────────────────────────────────────
// Alert conditions
//
// Marker visibility does not control alerts. Date/data guards apply to both.
// Alerts remain eligible in future sessions once each day's range is valid.
//──────────────────────────────────────────────────────────────────────────────

alertcondition(
     condition = enableUpperAlert and upperBreakout,
     title = "ORB — Upper 5M breakout",
     message = "{{ticker}}: a confirmed 5-minute candle crossed and closed above the ORB range.")

alertcondition(
     condition = enableLowerAlert and lowerBreakout,
     title = "ORB — Lower 5M breakout",
     message = "{{ticker}}: a confirmed 5-minute candle crossed and closed below the ORB range.")
